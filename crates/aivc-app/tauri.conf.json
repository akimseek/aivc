{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI 可视化控制台",
  "version": "0.1.0",
  "identifier": "com.aivc.console",
  "mainBinaryName": "AI",
  "build": {
    "frontendDist": "../../ui/dist",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
