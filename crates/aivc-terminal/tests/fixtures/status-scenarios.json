{
  "_comment": "终端状态检测器的对拍场景。Node 侧的生成脚本与 Rust 侧的差分测试都读这个文件，因此两边不可能漂移。steps 里每一步是 {input}（用户输入）、{output}（PTY 输出）或 {exit}（进程退出码）。",
  "scenarios": [
    {
      "name": "空输入不开始轮次",
      "providerId": "codex",
      "steps": [
        { "input": "" },
        { "input": "   " },
        { "input": "\r\n" }
      ]
    },
    {
      "name": "控制序列不算用户输入",
      "providerId": "codex",
      "steps": [
        { "input": "\u001b[A" },
        { "input": "\u001b[31m" }
      ]
    },
    {
      "name": "首次输入开始轮次",
      "providerId": "codex",
      "steps": [{ "input": "hello" }]
    },
    {
      "name": "同轮内的重复输入不重置",
      "providerId": "codex",
      "steps": [
        { "input": "first" },
        { "input": "second" },
        { "input": "third" }
      ]
    },
    {
      "name": "无轮次时输出被忽略",
      "providerId": "codex",
      "steps": [{ "output": "\n› Ask Codex to do anything\n" }]
    },
    {
      "name": "启动提示符不算完成",
      "providerId": "codex",
      "steps": [
        { "input": "hello" },
        { "output": "\n› Ask Codex to do anything\n" }
      ]
    },
    {
      "name": "提示符消失又回来才算完成",
      "providerId": "codex",
      "steps": [
        { "input": "hello" },
        { "output": "thinking...\n" },
        { "output": "\n› Ask Codex to do anything\n" }
      ]
    },
    {
      "name": "提示符被切成两批仍可识别",
      "providerId": "codex",
      "steps": [
        { "input": "hello" },
        { "output": "output\n" },
        { "output": "\n› Ask Codex to do " },
        { "output": "anything\n" }
      ]
    },
    {
      "name": "带 ANSI 颜色的一行",
      "providerId": "codex",
      "steps": [
        { "input": "hello" },
        { "output": "\u001b[31mthinking\u001b[0m\n" },
        { "output": "\u001b[1;32m› Ask Codex to do anything\u001b[m\n" }
      ]
    },
    {
      "name": "OSC 序列被剥离",
      "providerId": "codex",
      "steps": [
        { "input": "hello" },
        { "output": "\u001b]0;title\u0007noise\n" },
        { "output": "\n› Ask Codex to do anything\n" }
      ]
    },
    {
      "name": "流中断报错",
      "providerId": "codex",
      "steps": [
        { "input": "hello" },
        { "output": "stream disconnected before completion: broken pipe\n" }
      ]
    },
    {
      "name": "传输错误报错",
      "providerId": "codex",
      "steps": [
        { "input": "hello" },
        { "output": "Transport error: connection reset\n" }
      ]
